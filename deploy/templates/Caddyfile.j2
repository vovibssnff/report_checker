{% if caddy_domain | default('') | length > 0 %}
{% if edge_tls_terminated | bool %}
:80 {
{% else %}
{% if caddy_tls_email | default('') | length > 0 %}
{
	email {{ caddy_tls_email }}
}
{% endif %}

{{ caddy_domain }} {
{% endif %}
{% else %}
{
	default_sni {{ ansible_host }}
}

https://{{ ansible_host }} {
	tls internal
{% endif %}

	request_body {
		max_size {{ max_file_size_mb + 5 }}MB
	}

	reverse_proxy /api/* backend:8000
	reverse_proxy /docs* backend:8000
	reverse_proxy /openapi.json backend:8000
	reverse_proxy /health backend:8000

	# MinIO API behind path prefix.
	handle_path /s3/* {
		reverse_proxy minio:9000
	}
	redir /s3 /s3/ permanent

	# MinIO console behind path prefix.
	handle_path /minio-console/* {
		reverse_proxy minio:9001
	}
	redir /minio-console /minio-console/ permanent

	# Serve frontend for all non-API routes, including "/".
	handle {
		reverse_proxy frontend:80
	}
}

{% if caddy_domain | default('') | length == 0 %}
:80 {
	redir https://{{ ansible_host }}{uri} permanent
}
{% endif %}
