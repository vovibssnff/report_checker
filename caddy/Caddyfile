localhost {
	request_body {
		max_size 55MB
	}

	reverse_proxy /api/* backend:8000
	reverse_proxy /docs* backend:8000
	reverse_proxy /openapi.json backend:8000
	reverse_proxy /health backend:8000

	# MinIO API behind path prefix.
	handle_path /s3/* {
		reverse_proxy minio:9000
	}
	redir /s3 /s3/ permanent

	# MinIO console behind path prefix.
	handle_path /minio-console/* {
		reverse_proxy minio:9001
	}
	redir /minio-console /minio-console/ permanent

	# Serve frontend for all non-API routes, including "/".
	handle {
		reverse_proxy frontend:80
	}
}
